{
  "name": "glyphtracy-ts",
  "version": "0.1.0",
  "description": "TypeScript port of glyphtracy for raster to Bezier vectorization",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && webpack --config webpack.config.cjs",
    "build:web": "webpack --config webpack.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "marchingsquares": "^1.3.3",
    "paper": "^0.12.18"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^13.0.1",
    "html-webpack-plugin": "^5.6.3",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1"
  }
}
